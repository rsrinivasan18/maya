# Real secret values — never commit
terraform.tfvars

# Terraform working directory
.terraform/

# State files — use remote state (S3) for team; local for solo
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
